# Copy to /opt/cyber-wolf/prod/.env or /opt/cyber-wolf/dev/.env on the server.
# Never commit real secrets.

NODE_ENV=production
APP_PORT=3001
APP_NAME="Cyber Wolf API"
API_PREFIX=api
APP_FALLBACK_LANGUAGE=en
APP_HEADER_LANGUAGE=x-custom-lang
FRONTEND_DOMAIN=https://qibmz.com
BACKEND_DOMAIN=https://cyber-wolf-backend.qibmz.com
APP_CORS_ORIGINS=https://qibmz.com

DATABASE_TYPE=postgres
DATABASE_HOST=postgres
DATABASE_PORT=5432
DATABASE_USERNAME=root
DATABASE_PASSWORD=replace-with-strong-password
DATABASE_NAME=cyber_wolf
DATABASE_SYNCHRONIZE=false
DATABASE_MAX_CONNECTIONS=20
DATABASE_SSL_ENABLED=false
DATABASE_REJECT_UNAUTHORIZED=false

FILE_DRIVER=local
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_IGNORE_TLS=true
MAIL_SECURE=false
MAIL_REQUIRE_TLS=false
MAIL_DEFAULT_EMAIL=noreply@qibmz.com
MAIL_DEFAULT_NAME=CyberWolf

AUTH_JWT_SECRET=replace-with-long-random
AUTH_JWT_TOKEN_EXPIRES_IN=15m
AUTH_REFRESH_SECRET=replace-with-long-random
AUTH_REFRESH_TOKEN_EXPIRES_IN=30d
AUTH_FORGOT_SECRET=replace-with-long-random
AUTH_FORGOT_TOKEN_EXPIRES_IN=30m
AUTH_CONFIRM_EMAIL_SECRET=replace-with-long-random
AUTH_CONFIRM_EMAIL_TOKEN_EXPIRES_IN=1d
AUTH_UNIFORM_ERRORS=true

WALLET_DOMAIN=qibmz.com
